HOST_UID=1000
HOST_GID=1000
CONTAINER_USER=nvidia
CONTAINER_NAME=slam-ros2-dev
IMAGE_NAME=slam-ros2-dev:jazzy
NETWORK_NAME=slam-ros2-dev-net
ROS_DOMAIN_ID=49
GZ_PARTITION=slam-dev-49
DISPLAY=:1
XAUTHORITY_FILE=/run/user/1000/gdm/Xauthority

# Qt/Gazebo 的 GUI 走 X11(xcb)，不要让它选 wayland，否则报 failed to create drawable
QT_QPA_PLATFORM=xcb

# 1 = 强制 llvmpipe 软件渲染（无 GPU 直通时用这个，能跑通但帧率低）
# 0 = 使用真实 GPU；需要同时启用下面的 COMPOSE_FILE 覆盖文件
LIBGL_ALWAYS_SOFTWARE=1

# 有 NVIDIA GPU 直通能力时取消注释，start.sh 会自动带上 GPU 覆盖文件
# COMPOSE_FILE=compose.yaml:compose.nvidia.yaml
# NVIDIA_VISIBLE_DEVICES=all
# NVIDIA_DRIVER_CAPABILITIES=all
# RENDER_GID=993

# Gazebo 模型缓存目录（持久化，避免容器重建后重新下载 Fuel 模型）
# GZ_CACHE_DIR=./gz-cache
